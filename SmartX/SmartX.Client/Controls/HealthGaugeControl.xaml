<UserControl x:Class="SmartX.Client.Controls.HealthGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="74" Height="74">
    <Grid>
        <Canvas Width="74" Height="74">
            <Path x:Name="TrackArc" StrokeThickness="5" Stroke="#2A3347" />
            <Path x:Name="ScoreArc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ScoreText" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="White" />
            <TextBlock Text="HEALTH" FontSize="7.5" HorizontalAlignment="Center"
                       Foreground="#8A93A6" Margin="0,-2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>