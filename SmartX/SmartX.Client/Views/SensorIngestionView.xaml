<UserControl x:Class="SmartX.Client.Views.SensorIngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls"
             FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="335" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Deployment sidebar ==================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel Margin="0,16,0,16">
                <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}"
                        Margin="16,0,16,16" Click="OnAddSensorClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" />
                        <TextBlock Text="Add Sensor" />
                    </StackPanel>
                </Button>

                <Grid DockPanel.Dock="Top" Margin="16,0,16,8">
                    <TextBlock Text="DEPLOYMENT HIERARCHY" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="ValidityDot" Width="7" Height="7" Margin="0,0,6,0"
                                 Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ValidityText" Text="Not checked" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Button DockPanel.Dock="Bottom" Content="Validate Hierarchy"
                        Style="{StaticResource SecondaryButton}" Margin="16,12,16,0"
                        Padding="14,9" Click="OnValidateHierarchyClick" />

                <!-- Errors from the recursive validator, when there are any -->
                <ItemsControl x:Name="ValidationErrorsList" DockPanel.Dock="Bottom"
                              Margin="16,8,16,0" Visibility="Collapsed" MaxHeight="120">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource StatusRed}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TreeView x:Name="HierarchyTree" BorderThickness="0" Background="Transparent"
                          ItemContainerStyle="{StaticResource HierarchyTreeItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnHierarchySelectionChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceCount, StringFormat=' ({0})'}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ==================== Active pillar content ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="296" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, live alerts, health gauge -->
            <Border Grid.Row="0" Style="{StaticResource DarkCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sensor Data Ingestion &amp; Telemetry" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Register nodes, simulate telemetry, and monitor mesh health in real time."
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0"
                                HorizontalAlignment="Right">
                        <TextBlock Text="TELEMETRY PULSE" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDarkDim}"
                                   HorizontalAlignment="Right" Margin="0,0,0,3" />
                        <TextBlock x:Name="StreakText" Text="--" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusGreenDot}"
                                   HorizontalAlignment="Right" Margin="0,0,0,5" />

                        <ItemsControl x:Name="AlertsList" HorizontalAlignment="Right">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource StatusAmberDot}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{StaticResource StatusAmberDot}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <controls:HealthGaugeControl x:Name="Gauge" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Registered sensors -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel Margin="20,16,20,8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Registered sensors" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ScopeText" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ShowAllButton" Content="Show all" Style="{StaticResource SecondaryButton}"
                                    Click="OnShowAllClick" />
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="OnRefreshClick" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="SensorsGrid" Style="{StaticResource DataTable}"
                              SelectionChanged="OnSensorSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="DEVICE" Width="290">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="*" />

                            <DataGridTemplateColumn Header="CATEGORY" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="9,3"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                                         Margin="0,0,7,0" Fill="#8B5CF6" />
                                                <TextBlock Text="{Binding Category}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="Environmental">
                                                <Setter TargetName="Dot" Property="Fill" Value="#22C55E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="PowerConsumption">
                                                <Setter TargetName="Dot" Property="Fill" Value="#3B82F6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="SoilMoisture">
                                                <Setter TargetName="Dot" Property="Fill" Value="#0EA5E9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="Temperature">
                                                <Setter TargetName="Dot" Property="Fill" Value="#F97316" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="WaterPump">
                                                <Setter TargetName="Dot" Property="Fill" Value="#14B8A6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="Valve">
                                                <Setter TargetName="Dot" Property="Fill" Value="#64748B" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ATTACH." Binding="{Binding AttachmentCount}" Width="95" />
                            <DataGridTextColumn Header="READINGS" Binding="{Binding TelemetryReadingCount}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Selection / action status strip -->
            <Grid Grid.Row="2" Margin="4,12,0,12">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 7 1 C 4 1 3 3 3 6 L 3 9 L 1.5 11.5 L 12.5 11.5 L 11 9 L 11 6 C 11 3 10 1 7 1 M 5.5 11.5 C 5.5 13 6.2 13.5 7 13.5 C 7.8 13.5 8.5 13 8.5 11.5"
                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Width="14" Height="15"
                          Stretch="None" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="ActionStatusText" Text="No device selected"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
                <Button x:Name="OpenInCommandStreamButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        IsEnabled="False" Click="OnOpenInCommandStreamClick"
                        ToolTip="See this device's live timeline, alerts and overrides on the Real-Time Command Stream">
                    <TextBlock Text="Open in Command Stream ↗" />
                </Button>
            </Grid>

            <!-- Telemetry readings + attachments -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel Margin="20,16,20,16">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Telemetry Readings" Style="{StaticResource SectionTitle}" />
                            <Button x:Name="SimulateBatchButton" Content="Simulate Batch"
                                    Style="{StaticResource PrimaryButton}" Padding="14,7"
                                    HorizontalAlignment="Right" IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Select a sensor in the table above."
                                    Click="OnSimulateBatchClick" />
                        </Grid>

                        <Border x:Name="LastBatchStrip" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="{StaticResource AccentBlueSoft}" CornerRadius="5"
                                Padding="11,7" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="LAST BATCH" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock x:Name="LastBatchSummary" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LastBatchCountJump" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               Foreground="{StaticResource AccentBlue}" />
                                </Grid>



                            </StackPanel>
                        </Border>

                        <Grid>
                            <ListView x:Name="TelemetryHistoryList" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FromBatch}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBlueSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time" Width="150"
                                                        DisplayMemberBinding="{Binding TimestampUtc, StringFormat=HH:mm:ss}" />
                                        <GridViewColumn Header="Value" Width="120"
                                                        DisplayMemberBinding="{Binding Value}" />
                                        <GridViewColumn Header="Unit" Width="80"
                                                        DisplayMemberBinding="{Binding Unit}" />
                                        <GridViewColumn Header="Source" Width="82">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="BatchTag" Visibility="Collapsed"
                                                            Background="{StaticResource AccentBlue}"
                                                            CornerRadius="3" Padding="6,1"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="batch" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextOnDark}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding FromBatch}" Value="True">
                                                            <Setter TargetName="BatchTag" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel x:Name="TelemetryEmptyState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Path Data="M 0 10 L 5 10 L 8 3 L 13 17 L 16 10 L 22 10"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="22" Height="20" Stretch="None"
                                      HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="No sensor selected" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a row in Registered sensors to view its readings."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="250" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel Margin="20,16,20,16">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Attachments" Style="{StaticResource SectionTitle}" />
                            <Button x:Name="AttachFileButton" Content="Attach File"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" Click="OnAttachFileClick" />
                        </Grid>

                        <Grid>
                            <ListBox x:Name="AttachmentsList" BorderThickness="0" Background="Transparent" />
                            <TextBlock x:Name="AttachmentsEmptyState"
                                       Text="Select a sensor to see its attachments."
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Operator-overloading aggregation strip -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid Margin="20,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Smart Meter Aggregation" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Operator overloading" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="MeterAggregationText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="Waiting for power telemetry..." Style="{StaticResource MutedText}" />

                    <StackPanel x:Name="MeterAggregationPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource StatusGreenDot}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="MeterAName" Style="{StaticResource MonoText}" Margin="0,0,7,0" />
                        <TextBlock x:Name="MeterAValue" Style="{StaticResource MonoText}" FontWeight="Bold" />
                        <TextBlock Text="+" Style="{StaticResource MonoText}" Margin="14,0" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource StatusGreenDot}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="MeterBName" Style="{StaticResource MonoText}" Margin="0,0,7,0" />
                        <TextBlock x:Name="MeterBValue" Style="{StaticResource MonoText}" FontWeight="Bold" />
                        <TextBlock Text="=" Style="{StaticResource MonoText}" Margin="14,0" />
                        <TextBlock x:Name="MeterTotalValue" FontFamily="{StaticResource MonoFont}"
                                   FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="combined" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


