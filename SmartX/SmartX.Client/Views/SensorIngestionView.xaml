<UserControl x:Class="SmartX.Client.Views.SensorIngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="#E3E7ED" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#3B4CCA" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Header + Engagement widget -->
            <Border Style="{StaticResource Card}" Background="#1B1F29" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sensor Data Ingestion &amp; Telemetry" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Register nodes, simulate telemetry, and monitor mesh health in real time." Foreground="#8A93A6" Margin="0,4,0,0" />
                    </StackPanel>

                    <controls:HealthGaugeControl x:Name="Gauge" Grid.Column="1" Margin="20,0" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="TELEMETRY PULSE" FontSize="10" Foreground="#5A6272" />
                        <TextBlock x:Name="StreakText" Text="0 clean reads in a row" FontSize="13" Foreground="White" FontWeight="SemiBold" Margin="0,2,0,6" />
                        <ItemsControl x:Name="AlertsList" MaxHeight="80">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#F2A61E" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Registration + Deployment / Sensor list -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Register Sensor" Style="{StaticResource SectionHeader}" />

                            <TextBlock Text="MAC Address / Unique Identifier" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MacAddressBox" Text="24:6F:28:AA:BB:CC" />

                            <TextBlock Text="Facility" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FacilityBox" Text="Facility A" />

                            <TextBlock Text="Zone" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ZoneBox" Text="Zone 1" />

                            <TextBlock Text="Sub-Zone / Node" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SubZoneBox" Text="Sub-Zone A" />

                            <TextBlock Text="Sensor Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CategoryCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Environmental" />
                                <ComboBoxItem Content="PowerConsumption" />
                                <ComboBoxItem Content="Actuator" />
                            </ComboBox>

                            <Button Content="Register Sensor" Style="{StaticResource PrimaryButton}" Click="OnRegisterSensorClick" />
                            <TextBlock x:Name="RegisterStatusText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Deployment Hierarchy Validation" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Recursively validates nested Facility -&gt; Zone -&gt; Sub-Zone -&gt; Device nodes."
                                       FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TreeView x:Name="DeploymentTree" Height="160" BorderThickness="1" BorderBrush="#E3E7ED">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" (" /><Run Text="{Binding NodeType, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <Button Content="Validate Hierarchy" Style="{StaticResource SecondaryButton}" Click="OnValidateHierarchyClick" />
                            <TextBlock x:Name="ValidationSuccessText" Text="Hierarchy is valid." Foreground="#16A34A"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" />
                            <ItemsControl x:Name="ValidationResultsList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#DC2626" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Registered Sensors" Style="{StaticResource SectionHeader}" />
                                <Button Content="Refresh" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                                        Margin="0" Padding="10,4" Click="OnRefreshSensorsClick" />
                            </Grid>

                            <DataGrid x:Name="SensorsGrid" Height="200" AutoGenerateColumns="False"
                                      IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                                      RowHeight="32" SelectionChanged="OnSensorSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device ID" Binding="{Binding Id}" Width="160" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" />
                                    <DataGridTextColumn Header="Attachments" Binding="{Binding AttachmentCount}" Width="90" />
                                    <DataGridTextColumn Header="Readings" Binding="{Binding TelemetryReadingCount}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="SelectedSensorHeader" Text="Select a sensor above" Style="{StaticResource SectionHeader}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Attach File" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="OnAttachFileClick" />
                                    <Button Content="Simulate Batch Telemetry" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="10,4" Click="OnSimulateBatchClick" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <ListView x:Name="TelemetryHistoryList" Height="160">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Time" Width="110" DisplayMemberBinding="{Binding TimestampUtc}" />
                                            <GridViewColumn Header="Value" Width="90" DisplayMemberBinding="{Binding Value}" />
                                            <GridViewColumn Header="Unit" Width="60" DisplayMemberBinding="{Binding Unit}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Attachments" FontSize="12" FontWeight="SemiBold" />
                                    <ListBox x:Name="AttachmentsList" Height="130" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="ActionStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#6B7280" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Operator overloading demo -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Smart Meter Aggregation (Operator Overloading)" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Two live power meters combined with the overloaded PowerReading + operator, refreshed with the telemetry feed."
                               FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock x:Name="MeterAggregationText" Text="Waiting for power telemetry..."
                               FontSize="14" FontWeight="SemiBold" Foreground="#3B4CCA" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
