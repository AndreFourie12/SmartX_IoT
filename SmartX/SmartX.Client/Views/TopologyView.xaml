<UserControl x:Class="SmartX.Client.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Windows' built-in icon font: Fluent Icons on Windows 11, MDL2 Assets on Windows 10 -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="8,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ Drop-down used by the history query ============ -->
        <Style x:Key="PickerCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverGrey}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueSoft}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD2DC" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedRowBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9"
                                           Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                            </Grid>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Header counters ============ -->
        <Style x:Key="KpiDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{StaticResource ShellDarkLine}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KpiTile" TargetType="StackPanel">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Margin" Value="18,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderKpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="KpiUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="6,0,0,3" />
        </Style>

        <!-- ============ Node list ============ -->
        <!-- A full-width row with a divider under it. Selected rows turn blue, down nodes red. -->
        <Style x:Key="NodeListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="0,0,0,1" CornerRadius="0" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverGrey}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDown}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusRedSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusRedBorder}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Bd" Property="CornerRadius" Value="6" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedRowBorder}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Bd" Property="CornerRadius" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <!-- The page fills the window like the other two pillars: the header takes what it needs and the two
         rows below share the rest in proportion. Lists scroll inside their cards and the mesh drawing
         scales to the room it is given, so nothing ever sits below the fold.

         Four columns serve both rows. On top, the node list sits over Connectivity, the mesh spans the two
         middle columns and the route card closes the row. Below, Self-healing sits under the left of the
         mesh and Historical telemetry runs under the rest. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6*" MinHeight="300" />
            <RowDefinition Height="4*" MinHeight="230" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.9*" MinWidth="250" />
            <ColumnDefinition Width="3.35*" MinWidth="225" />
            <ColumnDefinition Width="7.9*" MinWidth="300" />
            <ColumnDefinition Width="4.3*" MinWidth="312" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Header: title and the three counters ==================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource DarkCard}" CornerRadius="12" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Network Topology &amp; Mesh Routing" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="StatusText"
                               Text="How the ESP32 nodes link up, which route each one uses to the gateway, and what they reported over time."
                               Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" FontSize="12.5"
                               Margin="0,3,0,0" MaxWidth="720" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource KpiTile}" Margin="0,0,18,0">
                        <TextBlock Text="NODES ONLINE" Style="{StaticResource KpiLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OnlineValue" Text="--" Style="{StaticResource HeaderKpiValue}" />
                            <TextBlock x:Name="OnlineTotal" Style="{StaticResource KpiUnit}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="DownText" Text="" Style="{StaticResource KpiCaption}" Margin="0" />
                            <TextBlock x:Name="IsolatedText" Text="" Style="{StaticResource KpiCaption}" Margin="0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}">
                        <TextBlock Text="MESH LINKS" Style="{StaticResource KpiLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LinksValue" Text="--" Style="{StaticResource HeaderKpiValue}" />
                            <TextBlock x:Name="LinksTotal" Style="{StaticResource KpiUnit}" />
                        </StackPanel>
                        <TextBlock x:Name="LinksCaption" Text="" Style="{StaticResource KpiCaption}" Margin="0,1,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}" Margin="18,0,0,0">
                        <TextBlock Text="MST POWER COST" Style="{StaticResource KpiLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CostValue" Text="--" Style="{StaticResource HeaderKpiValue}" />
                            <TextBlock Text="mW" Style="{StaticResource KpiUnit}" />
                        </StackPanel>
                        <TextBlock x:Name="CostCaption" Text="" Style="{StaticResource KpiCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Mesh nodes: search + list ============ -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StreamCard}" Margin="0,10,0,0">
            <DockPanel Margin="16,14,16,10">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mesh nodes" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="NodeCountText" Style="{StaticResource CardCount}" />
                    </StackPanel>
                    <Button x:Name="ClearFiltersButton" Content="Clear filters" Style="{StaticResource LinkButton}"
                            FontSize="12" HorizontalAlignment="Right" Click="OnClearFiltersClick" IsEnabled="False" />
                </Grid>

                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Background="White">
                    <Grid>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="34,9,10,9"
                                 FontSize="13" VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"
                                 ToolTip="Search by name, node ID or MAC address." />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search name or node ID..."
                                   IsHitTestVisible="False" Foreground="{StaticResource TextMuted}"
                                   Margin="36,0,0,0" VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                </Border>

                <ListBox x:Name="NodeList" BorderThickness="0" Background="Transparent" Margin="-16,10,-16,0"
                         ItemContainerStyle="{StaticResource NodeListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnNodeSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="22,8,18,8" ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding HopsText}" FontSize="13" Foreground="{Binding HopsBrush}"
                                           VerticalAlignment="Top" Margin="10,1,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Centre: the mesh drawn from the snapshot ============ -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StreamCard}" Margin="10,10,0,0">
            <Grid Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="Mesh topology" Style="{StaticResource CardTitle}" FontSize="19" />

                    <Button x:Name="FailureButton" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="OnFailureClick"
                            ToolTip="Take the selected node down and watch the mesh route around it. Click again to bring it back.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FailureIcon" Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13"
                                       Foreground="{StaticResource StatusRed}" Margin="0,0,9,0" />
                            <TextBlock x:Name="FailureLabel" Text="Simulate node failure" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The key to the drawing -->
                <Border Grid.Row="1" Background="{StaticResource HoverGrey}" CornerRadius="8" Padding="14,9" Margin="0,12,0,0">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                            <Rectangle Width="22" Height="2" Fill="{StaticResource TextMuted}" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Standby link" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                            <Rectangle Width="22" Height="3" Fill="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="MST backbone" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                            <Border Background="{StaticResource AccentBlueSoft}" BorderBrush="{StaticResource SelectedRowBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="mW" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource AccentBlue}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                            <Rectangle Width="22" Height="4" Fill="{StaticResource StatusAmberDot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Selected route" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                            <Line X1="0" X2="22" Y1="1" Y2="1" Stroke="{StaticResource StatusRed}" StrokeThickness="2"
                                  StrokeDashArray="3,2" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Offline link" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,8,0">
                                <Ellipse Fill="White" Stroke="{StaticResource StatusGreenDot}" StrokeThickness="2" />
                                <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Hops to gateway" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Positions come from the gateway for a 1100 x 460 drawing area; the Viewbox scales it to whatever room is left -->
                <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource HoverGrey}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="MeshCanvas" Width="1100" Height="460" />
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Right column: route to gateway ============ -->
        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource StreamCard}" Margin="10,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,14,16,12">
                    <Grid>
                        <TextBlock Text="Route to gateway" Style="{StaticResource CardTitle}" />
                        <Button x:Name="OpenInStreamButton" Content="Open in Command Stream" Style="{StaticResource LinkButton}"
                                FontSize="11" HorizontalAlignment="Right" Click="OnOpenInStreamClick" />
                    </Grid>

                    <!-- The route in three figures -->
                    <Border Background="{StaticResource HoverGrey}" CornerRadius="8" Padding="16,6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.6*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="HOPS" Style="{StaticResource EyebrowText}" FontSize="10" />
                                <TextBlock x:Name="RouteHops" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="POWER" Style="{StaticResource EyebrowText}" FontSize="10" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RoutePower" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="mW" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="5,0,0,4" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VIA" Style="{StaticResource EyebrowText}" FontSize="10" />
                                <TextBlock x:Name="RouteVia" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Bottom" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="RouteList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="23" ToolTip="{Binding Tip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Marker on a vertical line: the line runs up and down from the dot unless this is an end of the route -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Width="2" Fill="{StaticResource StatusAmberDot}" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasLineAbove, Converter={StaticResource BoolToVisibility}}" />
                                        <Rectangle Grid.Row="1" Width="2" Fill="{StaticResource StatusAmberDot}" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasLineBelow, Converter={StaticResource BoolToVisibility}}" />
                                        <Ellipse Grid.RowSpan="2" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding MarkerFill}" Stroke="{Binding MarkerStroke}" StrokeThickness="2.5" />
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding NameWeight}" FontSize="14"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,6,0" />

                                    <TextBlock Grid.Column="2" Text="selected" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                               Visibility="{Binding IsOrigin, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CostText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                               Visibility="{Binding HasCost, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shown when the selected node had to find a different way round a failure -->
                    <Border x:Name="HopOverNote" Visibility="Collapsed" Background="{StaticResource HoverGrey}" CornerRadius="8"
                            Padding="10,7" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="HopOverText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                        </Grid>
                    </Border>

                    <!-- The same node routed three ways: the spanning tree (listed above), fewest hops, least power -->
                    <Grid x:Name="CompareHeader" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="COMPARE ROUTES" Style="{StaticResource EyebrowText}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="HOPS" Style="{StaticResource EyebrowText}" FontSize="10.5" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="POWER" Style="{StaticResource EyebrowText}" FontSize="10.5" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="RouteOptionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="23">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="74" />
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Method}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        <TextBlock Text="in use" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Visibility="{Binding InUse, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="{StaticResource StatusGreenSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Cheapest, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="CHEAPEST" Style="{StaticResource TagText}" FontSize="9.5" Foreground="{StaticResource StatusGreen}" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Hops}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding PowerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Power}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding PowerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="RouteNote" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                               LineHeight="16" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Connectivity: what a search from the gateway reaches ============ -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StreamCard}" Margin="0,10,0,0">
            <Grid Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="Connectivity" Style="{StaticResource CardTitle}" FontSize="17" />

                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BfsButton" Content="BFS" GroupName="Traversal" IsChecked="True"
                                         Style="{StaticResource SegmentButton}" Checked="OnTraversalChanged"
                                         ToolTip="Breadth-first: a queue, nearest nodes first." />
                            <RadioButton x:Name="DfsButton" Content="DFS" GroupName="Traversal"
                                         Style="{StaticResource SegmentButton}" Checked="OnTraversalChanged"
                                         ToolTip="Depth-first: a stack, one branch to its end before backing up." />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="ReachCount" Text="--" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="ReachSuffix" FontSize="13.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                </StackPanel>

                <!-- How much of the live mesh the search reached -->
                <Grid Grid.Row="2" Height="6" Margin="0,4,0,0">
                    <Border Background="{StaticResource HoverGrey}" CornerRadius="3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ReachFill" Width="0*" />
                            <ColumnDefinition x:Name="ReachRest" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource StatusGreenDot}" CornerRadius="3" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource StatusGreenDot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StateText" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,12,0,5">
                    <TextBlock Text="VISIT ORDER" Style="{StaticResource EyebrowText}" FontSize="10.5" />
                    <TextBlock x:Name="OrderHint" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Right" />
                </Grid>

                <Border Grid.Row="5" Background="{StaticResource HoverGrey}" CornerRadius="8" Padding="12,4,4,4" MinHeight="40">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OrderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="{Binding Number}" Width="22" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Self-healing: what the last failure did ============ -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StreamCard}" Margin="10,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Self-healing" Style="{StaticResource CardTitle}" FontSize="17" />
                        <Border x:Name="HealBadge" Visibility="Collapsed" CornerRadius="4" Padding="7,2" Margin="12,1,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HealBadgeText" Style="{StaticResource TagText}" FontSize="10" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="HealEmpty" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                               Text="No failure yet. Select a node and choose Simulate node failure to see the mesh route around it." />

                    <Border x:Name="HealSummary" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="10,7" Margin="0,8,0,0">
                        <TextBlock x:Name="HealText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextPrimary}" />
                    </Border>

                    <TextBlock x:Name="HealListTitle" Visibility="Collapsed" Style="{StaticResource EyebrowText}" FontSize="10.5" Margin="0,14,0,4" />
                    <ItemsControl x:Name="HealList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding Change}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== Historical telemetry: a range query on the timeline tree ==================== -->
        <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource StreamCard}" Margin="10,10,0,0">
            <Grid Margin="18,12,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Historical telemetry" Style="{StaticResource CardTitle}" FontSize="17" />

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Every choice here is picked from a list, so a query can never be typed wrongly -->
                    <StackPanel>
                        <TextBlock Text="SENSOR" Style="{StaticResource EyebrowText}" FontSize="10" Margin="0,0,0,3" />
                        <ComboBox x:Name="HistorySensorBox" Style="{StaticResource PickerCombo}" ToolTip="Any node in the mesh.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FROM" Style="{StaticResource EyebrowText}" FontSize="10" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="HistoryFromDate" Style="{StaticResource PickerCombo}" SelectionChanged="OnPickerChanged" ToolTip="Day" />
                            <ComboBox x:Name="HistoryFromHour" Grid.Column="2" Style="{StaticResource PickerCombo}" MinWidth="58"
                                      FontFamily="{StaticResource MonoFont}" SelectionChanged="OnPickerChanged" ToolTip="Hour (24 hour clock)" />
                            <TextBlock Grid.Column="3" Text=":" Margin="3,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            <ComboBox x:Name="HistoryFromMinute" Grid.Column="4" Style="{StaticResource PickerCombo}" MinWidth="58"
                                      FontFamily="{StaticResource MonoFont}" SelectionChanged="OnPickerChanged" ToolTip="Minute" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TO" Style="{StaticResource EyebrowText}" FontSize="10" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="HistoryToDate" Style="{StaticResource PickerCombo}" SelectionChanged="OnPickerChanged" ToolTip="Day" />
                            <ComboBox x:Name="HistoryToHour" Grid.Column="2" Style="{StaticResource PickerCombo}" MinWidth="58"
                                      FontFamily="{StaticResource MonoFont}" SelectionChanged="OnPickerChanged" ToolTip="Hour (24 hour clock)" />
                            <TextBlock Grid.Column="3" Text=":" Margin="3,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            <ComboBox x:Name="HistoryToMinute" Grid.Column="4" Style="{StaticResource PickerCombo}" MinWidth="58"
                                      FontFamily="{StaticResource MonoFont}" SelectionChanged="OnPickerChanged" ToolTip="Minute (the query runs to the end of it)" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="RunQueryButton" Grid.Column="6" Content="Run query" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Bottom" Padding="18,8" Click="OnRunQueryClick" IsEnabled="False" />
                </Grid>

                <TextBlock x:Name="HistoryError" Grid.Row="2" Visibility="Collapsed" Foreground="{StaticResource StatusRedText}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinHeight="60">
                        <controls:TimelineChart x:Name="HistoryChart" />
                    </Border>

                    <Border Grid.Column="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="12,8,4,4" MinHeight="60">
                        <DataGrid x:Name="HistoryTable" Style="{StaticResource DataTable}" IsHitTestVisible="True"
                                  VerticalScrollBarVisibility="Auto" Focusable="False">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCell}">
                                    <Setter Property="Padding" Value="0,4" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="HistoryValueColumn" Header="VALUE" Binding="{Binding Value}" Width="Auto" MinWidth="100">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="0,0,14,6" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,14,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <TextBlock x:Name="HistoryCaption" Grid.Row="4" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,6,0,0" Text="Choose a sensor and a time range, then Run query." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
