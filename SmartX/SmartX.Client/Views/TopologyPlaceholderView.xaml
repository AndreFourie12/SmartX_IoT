<UserControl x:Class="SmartX.Client.Views.TopologyPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DarkCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Network Topology &amp; Mesh Routing" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource PillBadge}" Margin="12,0,0,0">
                        <TextBlock Text="FINAL POE" Style="{StaticResource PillBadgeText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Visualise the ESP32 mesh, trace how each node's packets hop back to the gateway, and query its history."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Path Data="M 30 6 L 10 30 M 30 6 L 50 30 M 10 30 L 30 54 M 50 30 L 30 54 M 10 30 L 50 30"
                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Width="60" Height="60" HorizontalAlignment="Center" />
                <TextBlock Text="This pillar is built in the final part of the PoE" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="The navigation is live so all three pillars can be reached, and the other two keep running while you are here. Planned for this module:" />

                <StackPanel Margin="0,22,0,0">
                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Mesh graph" /> - ESP32 nodes as vertices, wireless links as edges.
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="BFS / DFS" /> - every device reachable from a gateway, and where to hop when a node is down.
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Minimum spanning tree" /> - the most power-efficient routing (Prim's or Kruskal's).
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Self-balancing tree history" /> - time-range queries over a node's telemetry.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
