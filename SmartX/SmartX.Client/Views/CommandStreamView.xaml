<UserControl x:Class="SmartX.Client.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A text line that disappears when bound to null or empty -->
        <Style x:Key="CollapsibleText" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EyebrowSmall" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="KpiDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Background" Value="{StaticResource ShellDarkAlt}" />
        </Style>

        <Style x:Key="KpiTile" TargetType="StackPanel">
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Margin" Value="22,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fleet row container: a full-width row with a divider under it, tinted when hovered or selected -->
        <Style x:Key="DeviceListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverGrey}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header: live status, queue KPIs, test controls ==================== -->
        <Border Grid.Row="0" Style="{StaticResource DarkCard}" CornerRadius="12" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Real-Time Command Stream &amp; History" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border x:Name="LivePill" CornerRadius="11" Padding="10,3" Background="Transparent"
                                BorderBrush="{StaticResource ShellDarkLine}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource StatusAmberDot}"
                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveText" Text="CONNECTING" Style="{StaticResource TagText}" FontSize="11"
                                           Foreground="{StaticResource StatusAmberDot}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ActionStatusText" Text="Watching the gateway's queues..."
                                   FontSize="13" Foreground="{StaticResource TextOnDarkMuted}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Queue KPIs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}"
                                ToolTip="Routine packets wait here in arrival order: Queue&lt;T&gt;, first in, first out.">
                        <TextBlock Text="ROUTINE QUEUE · FIFO" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="RoutineDepthText" Text="0" Style="{StaticResource KpiValue}" />
                        <Border Width="138" Height="3" CornerRadius="2" Background="#2A3347" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <Border x:Name="RoutineDepthBar" Width="0" CornerRadius="2" Background="{StaticResource AccentBlue}" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="RoutineWaitText" Text="avg wait --" Style="{StaticResource KpiCaption}" Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}"
                                ToolTip="Readings that break a threshold go into a PriorityQueue that is always emptied first.">
                        <TextBlock Text="ALERT LANE · PRIORITY" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="AlertDepthText" Text="0" Style="{StaticResource KpiValue}" Foreground="#F87171" />
                        <TextBlock x:Name="AlertWaitText" Text="avg wait --" Style="{StaticResource KpiCaption}" Margin="0,4,0,0" />
                        <TextBlock x:Name="AlertBypassText" Text="no bypasses yet" Style="{StaticResource KpiCaption}" />
                    </StackPanel>

                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}" MinWidth="118">
                        <TextBlock Text="THROUGHPUT" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="ThroughputValue" Text="--" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="BudgetText" Text="budget --" Style="{StaticResource KpiCaption}" Margin="0,4,0,0" />
                        <TextBlock x:Name="ProcessedText" Text="--" Style="{StaticResource KpiCaption}" />
                    </StackPanel>

                    <Border Style="{StaticResource KpiDivider}" />
                    <StackPanel Style="{StaticResource KpiTile}"
                                ToolTip="Repeat alerts for a fault or outage that is already active, refused by the gateway's HashSets.">
                        <TextBlock Text="DUPLICATES BLOCKED" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="DuplicatesText" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="FaultsText" Text="-- active" Style="{StaticResource KpiCaption}" Margin="0,4,0,0" />
                        <TextBlock x:Name="OfflineText" Text="-- offline" Style="{StaticResource KpiCaption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Test controls -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="250" Margin="6,0,0,0">
                    <Button x:Name="InjectAlertButton" Style="{StaticResource DarkDangerButton}" Click="OnInjectAlertClick"
                            ToolTip="Send one out-of-range device packet to the API and watch it skip the routine queue.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 8.5 1 L 2.5 9 L 7 9 L 6 15 L 12.5 6.5 L 8 6.5 Z" Stroke="#FCA5A5" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" Width="15" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Simulate critical alert" VerticalAlignment="Center" />
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#FECACA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="8" Height="5" Stretch="None" VerticalAlignment="Center" Margin="12,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}" Tag="SEND ONE OUT-OF-RANGE PACKET" VerticalOffset="6"
                                         MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}" />
                                    <Style x:Key="MenuIcon" TargetType="Border">
                                        <Setter Property="Width" Value="30" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="MenuTitle" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource TextOnDark}" />
                                    </Style>
                                    <Style x:Key="MenuCaption" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextOnDarkMuted}" />
                                        <Setter Property="Margin" Value="0,2,0,0" />
                                    </Style>
                                </ContextMenu.Resources>

                                <MenuItem Tag="power" Click="OnInjectMenuClick">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource MenuIcon}" Background="#3A1F27">
                                                <Path Data="M 8.5 1 L 2.5 9 L 7 9 L 6 15 L 12.5 6.5 L 8 6.5 Z" Stroke="#F87171" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round" Width="15" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Severe power spike" Style="{StaticResource MenuTitle}" />
                                                <TextBlock Text="Smart meter · 650–950 W" Style="{StaticResource MenuCaption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="moisture" Click="OnInjectMenuClick">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource MenuIcon}" Background="#1A2B45">
                                                <Path Data="M 6.5 1.5 C 6.5 1.5 2 7 2 10 A 4.5 4.5 0 0 0 11 10 C 11 7 6.5 1.5 6.5 1.5 Z" Stroke="#60A5FA" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round" Width="13" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Critical moisture drop" Style="{StaticResource MenuTitle}" />
                                                <TextBlock Text="Soil probe · 8–15 %" Style="{StaticResource MenuCaption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="heat" Click="OnInjectMenuClick">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource MenuIcon}" Background="#3A2A1A">
                                                <Path Data="M 5 2.5 A 1.5 1.5 0 0 1 8 2.5 L 8 9.4 A 3 3 0 1 1 5 9.4 Z" Stroke="#FB923C" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round" Width="13" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Overheating" Style="{StaticResource MenuTitle}" />
                                                <TextBlock Text="Greenhouse probe · 41–44 °C" Style="{StaticResource MenuCaption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="StormButton" Style="{StaticResource DarkButton}" Margin="0,10,0,0" Click="OnStormClick"
                            ToolTip="The simulated fleet flushes 1,200 buffered readings at once - far beyond the gateway's processing budget - with one severe spike hidden halfway through.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1 3 L 14 3 M 1 7.5 L 14 7.5 M 1 12 L 14 12" Stroke="{StaticResource TextOnDark}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Reconnect storm (load test)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Critical alert banner (raised by a new critical event) ==================== -->
        <Border x:Name="CriticalBanner" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed"
                Background="{StaticResource StatusRedSoft}" BorderBrush="{StaticResource StatusRedBorder}"
                BorderThickness="1" CornerRadius="10" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="⚡" FontSize="17" Foreground="{StaticResource StatusRed}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" Foreground="#991B1B" FontSize="13" />
                    <TextBlock x:Name="BannerDetail" Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Show device" Style="{StaticResource SmallButton}" Click="OnBannerFocusClick" />
                    <Button Content="✕" Style="{StaticResource LinkButton}" Foreground="#991B1B" FontSize="13"
                            Margin="14,0,2,0" Click="OnBannerCloseClick" ToolTip="Dismiss" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Body ==================== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" MinWidth="390" MaxWidth="540" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2.1*" MinWidth="460" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="360" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ============ Device fleet: search + filters ============ -->
            <Border Grid.Column="0" Style="{StaticResource StreamCard}">
                <DockPanel Margin="18,18,8,10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,10,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Device fleet" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="FleetCountText" Style="{StaticResource MutedText}" FontSize="13" Margin="8,1,0,0" />
                        </StackPanel>
                        <Button x:Name="ClearFiltersButton" Content="Clear filters" Style="{StaticResource LinkButton}"
                                Foreground="{StaticResource TextSecondary}" FontSize="13"
                                HorizontalAlignment="Right" Click="OnClearFiltersClick" IsEnabled="False" />
                    </Grid>

                    <!-- Search -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Background="#FAFBFC" Margin="0,0,10,0">
                        <Grid>
                            <Path Data="M 5.5 1 A 4.5 4.5 0 1 0 5.51 1 M 8.8 8.8 L 12 12" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.4" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="None"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="36,10,30,10"
                                     FontSize="13.5" VerticalContentAlignment="Center"
                                     TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Search by name, ID, zone or category"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextSecondary}"
                                       Margin="38,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                            <Button x:Name="ClearSearchButton" Content="✕" Style="{StaticResource LinkButton}"
                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                    Visibility="Collapsed" Click="OnClearSearchClick" ToolTip="Clear search" />
                        </Grid>
                    </Border>

                    <!-- Searches the engine expects the operator to make next -->
                    <StackPanel x:Name="PredictedPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,10,0"
                                Visibility="Collapsed"
                                ToolTip="Predicted from operator history: what usually gets searched next, and what the active alerts usually lead to.">
                        <TextBlock Text="✦ ANTICIPATED" Style="{StaticResource TagText}" FontSize="11" Foreground="{StaticResource InsightText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ItemsControl x:Name="PredictedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnPredictedSearchClick" Cursor="Hand" Margin="0,0,6,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{StaticResource InsightSoft}" BorderBrush="{StaticResource InsightBorder}"
                                                        BorderThickness="1" CornerRadius="12" Padding="10,3">
                                                    <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#92400E" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FDE68A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Category and alert-state filters: one choice each, "All" by default -->
                    <Grid DockPanel.Dock="Top" Margin="0,16,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="OPERATIONAL CATEGORY" Style="{StaticResource EyebrowSmall}" Margin="0,0,0,7" />
                        <ComboBox x:Name="CategoryFilter" Grid.Row="1" Style="{StaticResource FilterCombo}"
                                  DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" />

                        <TextBlock Grid.Column="2" Text="ALERT STATE" Style="{StaticResource EyebrowSmall}" Margin="0,0,0,7" />
                        <ComboBox x:Name="AlertFilter" Grid.Row="1" Grid.Column="2" Style="{StaticResource FilterCombo}"
                                  DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" />
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorder}" Margin="-18,16,-8,0" />

                    <Grid>
                        <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent" Margin="-18,0,0,0"
                                 ItemContainerStyle="{StaticResource DeviceListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="OnDeviceSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="22,15,16,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <!-- The status tag drops under the name when the column is narrow -->
                                            <WrapPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                                                <Border Background="{Binding StatusSoftBrush}" CornerRadius="4" Padding="6,1"
                                                        Margin="0,2,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TagText}" FontSize="10"
                                                               Foreground="{Binding StatusBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18" />
                                            <TextBlock Text="{Binding AlertReason}" Style="{StaticResource CollapsibleText}"
                                                       Foreground="{Binding StatusBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding HighlightReason}" Style="{StaticResource CollapsibleText}"
                                                       Foreground="{StaticResource InsightText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="92" Margin="12,0,0,0">
                                            <Border Background="{StaticResource InsightSoft}" CornerRadius="5" Padding="8,2"
                                                    Margin="0,0,0,8" HorizontalAlignment="Right"
                                                    Visibility="{Binding Highlighted, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="✦ INSIGHT" Style="{StaticResource TagText}" FontSize="11" Foreground="#92400E" />
                                            </Border>
                                            <Border HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <!-- Pumps, valves and relays show their state as a small grey tag -->
                                                            <DataTrigger Binding="{Binding IsActuator}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource NeutralSoft}" />
                                                                <Setter Property="CornerRadius" Value="6" />
                                                                <Setter Property="Padding" Value="9,2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="14.5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActuator}" Value="True">
                                                                    <Setter Property="FontSize" Value="12.5" />
                                                                    <Setter Property="Foreground" Value="#374151" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding PendingText}" Style="{StaticResource CollapsibleText}"
                                                       FontSize="11.5" Foreground="{StaticResource StatusAmber}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding LastSeenText}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="FleetEmptyText" Text="No devices match these filters." Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ============ Middle: selected device timeline + manual override ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StreamCard}">
                    <DockPanel Margin="24,20,24,16">
                        <Grid DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DetailDot" Width="10" Height="10" Fill="{StaticResource TextMuted}" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DetailName" Text="No device selected" Style="{StaticResource SectionTitle}" FontSize="20" />
                            </StackPanel>
                            <Button x:Name="OpenInIngestionButton" Style="{StaticResource LinkButton}" FontSize="13.5" HorizontalAlignment="Right"
                                    Click="OnOpenInIngestionClick" IsEnabled="False"
                                    ToolTip="Open this device in the Sensor Data Ingestion pillar (readings, attachments, batches)">
                                <TextBlock Text="Open in Ingestion ↗" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DetailId" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="21,6,0,0" TextTrimming="CharacterEllipsis" />

                        <Grid DockPanel.Dock="Top" Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DetailValue" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="46"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="DetailUnit" FontFamily="{StaticResource MonoFont}" FontSize="18"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="5,0,0,9" />
                                </StackPanel>
                                <TextBlock x:Name="DetailState" FontSize="13.5" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,0" MaxWidth="420" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="1m" Tag="1" GroupName="Range" Style="{StaticResource SegmentButton}" Checked="OnRangeChecked" />
                                        <RadioButton Content="5m" Tag="5" GroupName="Range" Style="{StaticResource SegmentButton}" Checked="OnRangeChecked" IsChecked="True" />
                                        <RadioButton Content="15m" Tag="15" GroupName="Range" Style="{StaticResource SegmentButton}" Checked="OnRangeChecked" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SegmentHost}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Chart" GroupName="View" Style="{StaticResource SegmentButton}" Checked="OnViewModeChecked" IsChecked="True" />
                                        <RadioButton x:Name="LogModeButton" Content="Log" GroupName="View" Style="{StaticResource SegmentButton}" Checked="OnViewModeChecked" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DetailFooter" DockPanel.Dock="Bottom" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />

                        <Grid>
                            <controls:TimelineChart x:Name="Chart" />
                            <ListView x:Name="LogList" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Timestamp" Width="120" DisplayMemberBinding="{Binding Time}" />
                                        <GridViewColumn Header="Reading" Width="120" DisplayMemberBinding="{Binding Value}" />
                                        <GridViewColumn Header="Δ previous" Width="100" DisplayMemberBinding="{Binding Delta}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Manual override with the stack-based undo history -->
                <Border Grid.Row="2" Style="{StaticResource StreamCard}">
                    <StackPanel Margin="24,20,24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Manual override" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="OverrideTarget" Text="Select a pump, valve or relay to command it."
                                           Style="{StaticResource MutedText}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Button x:Name="UndoButton" Style="{StaticResource SmallButton}" Click="OnUndoClick" IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Nothing to undo">
                                    <TextBlock Text="↶  Undo" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- This device's commands, then the group commands; they wrap onto two lines when narrow -->
                        <WrapPanel Margin="0,16,0,0">
                            <StackPanel x:Name="DeviceCommandPanel" Orientation="Horizontal" IsEnabled="False"
                                        VerticalAlignment="Bottom" Margin="0,0,40,8">
                                <Button x:Name="TurnOnButton" Content="Turn ON" Style="{StaticResource CommandPrimaryButton}" Tag="TurnOn" Click="OnDeviceCommandClick" />
                                <Button x:Name="TurnOffButton" Content="Turn OFF" Style="{StaticResource CommandButton}" Tag="TurnOff" Click="OnDeviceCommandClick" Margin="10,0,0,0" />
                                <Button Content="Toggle" Style="{StaticResource CommandButton}" Tag="Toggle" Click="OnDeviceCommandClick" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="GROUP COMMANDS" Style="{StaticResource EyebrowSmall}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Shut down all valves" Style="{StaticResource CommandButton}" Tag="AllValves|TurnOff"
                                            Click="OnGroupCommandClick" />
                                    <Button Content="Stop all pumps" Style="{StaticResource CommandButton}" Tag="AllPumps|TurnOff"
                                            Click="OnGroupCommandClick" Margin="10,0,0,0" />
                                    <Button Style="{StaticResource DangerButton}" Tag="AllActuators|TurnOff" Click="OnGroupCommandClick" Margin="10,0,0,0"
                                            ToolTip="Switch every pump, valve and relay OFF - one undo restores them all.">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                                                <Ellipse Stroke="White" StrokeThickness="1.4" />
                                                <Path Data="M 7.5 4 L 7.5 8.5 M 7.5 11 L 7.5 11.2" Stroke="White" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                            <TextBlock Text="Emergency stop" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12,0,16" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="UNDO STACK" Style="{StaticResource EyebrowSmall}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UndoCountText" Text="(0)" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MonoFont}"
                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UndoStackList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="7" Padding="11,7" Margin="0,0,0,4" Background="#F9FAFB"
                                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="NextTag" Text="NEXT UNDO" Style="{StaticResource TagText}" Foreground="{StaticResource AccentBlue}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBlueSoft}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource SelectedRowBorder}" />
                                                <Setter TargetName="NextTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="UndoEmptyText" Text="No commands yet - everything you send here can be undone."
                                   FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Right: suggested actions + live stream ============ -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StreamCard}">
                    <DockPanel Margin="20,18,16,12">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,4,14">
                            <Grid>
                                <TextBlock Text="Suggested Actions" Style="{StaticResource CardTitle}" />
                                <Border Background="{StaticResource InsightSoft}" BorderBrush="{StaticResource InsightBorder}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="AUTOMATED INSIGHTS" Style="{StaticResource TagText}" Foreground="{StaticResource InsightText}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="InsightsSubtitle" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Expander DockPanel.Dock="Bottom" Margin="0,8,4,0" FontSize="12" Foreground="{StaticResource TextSecondary}">
                            <Expander.Header>
                                <TextBlock Text="Learned patterns (condition → operator response)" FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                            </Expander.Header>
                            <ItemsControl x:Name="PatternList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Condition}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="→ " /><Run Text="{Binding Response, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border Width="60" Height="4" CornerRadius="2" Background="{StaticResource InsightBarTrack}" HorizontalAlignment="Right">
                                                    <Border Width="{Binding BarWidth}" CornerRadius="2" Background="{StaticResource InsightBar}" HorizontalAlignment="Left" />
                                                </Border>
                                                <TextBlock Text="{Binding Support}" FontSize="10.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InsightList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="1"
                                                    CornerRadius="10" Margin="0,0,4,10" Padding="16,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource TagText}" FontSize="10.5"
                                                                   Foreground="{Binding AccentText}" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="Engine confidence">
                                                            <Border Width="68" Height="4" CornerRadius="2" Background="{Binding AccentTrack}" VerticalAlignment="Center">
                                                                <Border Width="{Binding ConfidenceBarWidth}" CornerRadius="2" Background="{Binding AccentBar}" HorizontalAlignment="Left" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Foreground="{Binding AccentText}"
                                                                       FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                               TextWrapping="Wrap" Margin="0,9,0,6" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="#4B5563" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Evidence}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                        <Button Style="{StaticResource SmallPrimaryButton}" Click="OnRunInsightClick"
                                                                Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}"
                                                                ToolTip="{Binding Command.Label}" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="M 0 0 L 7 4.5 L 0 9 Z" Fill="White" Width="7" Height="9" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                                <TextBlock Text="Run" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="Show device" Style="{StaticResource SmallButton}" Click="OnFocusInsightClick" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="InsightsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="✓" FontSize="20" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing needs attention right now." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource StreamCard}">
                    <DockPanel Margin="20,18,10,6">
                        <Grid DockPanel.Dock="Top" Margin="0,0,10,4">
                            <TextBlock Text="Live command stream" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="EventCountText" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <ListBox x:Name="EventList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse Fill="{Binding BadgeBrush}" />
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="12.5" FontWeight="Bold"
                                                           FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondary}" Margin="10,1,0,0" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2"
                                                            Visibility="{Binding ViaPriorityLane, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Background="{StaticResource StatusRedSoft}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="PRIORITY LANE" Style="{StaticResource TagText}" Foreground="{StaticResource StatusRed}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding PriorityText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                               Foreground="{StaticResource StatusRed}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
