<Window x:Class="SmartX.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X IoT Mesh Gateway" Height="820" Width="1360"
        MinHeight="640" MinWidth="1024"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D7DCE5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2F3D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A6272" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="62*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1B1F29" Margin="0,0,37,0" Grid.RowSpan="2">
            <DockPanel Margin="0,0,51,0">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="SMART-X" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="IoT Mesh Gateway" FontSize="12" Foreground="#8A93A6" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Width="181">
                    <Button x:Name="IngestionNavButton" Style="{StaticResource NavButton}" Click="OnIngestionNavClick">
                        <StackPanel>
                            <TextBlock Text="Sensor Data Ingestion" FontWeight="SemiBold" />
                            <TextBlock Text="&amp; Telemetry" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" IsEnabled="False"
                            ToolTip="Implemented in Part 2 of the PoE" Width="216">
                        <StackPanel>
                            <TextBlock Text="Real-Time Command " TextWrapping="Wrap" Width="215" />
                            <TextBlock Text="Stream &amp; History" />
                            <TextBlock Text="Coming in Part 2" FontSize="10" Foreground="#5A6272" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" IsEnabled="False"
                            ToolTip="Implemented in Part 3">
                        <StackPanel>
                            <TextBlock Text="Network Topology" />
                            <TextBlock Text="&amp; Mesh Routing" />
                            <TextBlock Text="Coming in final PoE" FontSize="10" Foreground="#5A6272" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>


            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="0,24,24,24" Grid.RowSpan="2" />
    </Grid>
</Window>