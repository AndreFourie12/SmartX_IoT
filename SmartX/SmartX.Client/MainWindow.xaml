<Window x:Class="SmartX.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X IoT Mesh Gateway" Height="920" Width="1520"
        MinHeight="720" MinWidth="1200"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Top navigation ==================== -->
        <Border Grid.Row="0" Background="{StaticResource ShellDark}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,24,0">
                    <Path Data="M 2 9 L 10 2 L 18 9 M 4.5 7.5 L 4.5 16 L 15.5 16 L 15.5 7.5"
                          Stroke="{StaticResource TextOnDarkMuted}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="18" Stretch="None" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMART-X" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextOnDark}" />
                        <TextBlock Text="IoT Mesh Gateway" FontSize="10.5"
                                   Foreground="{StaticResource TextOnDarkMuted}" Margin="0,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Three architectural pillars. Views are cached, so switching never loses state. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="IngestionTab" Style="{StaticResource NavTab}" GroupName="Pillars"
                                 Checked="OnPillarChecked" Tag="Ingestion"
                                 ToolTip="Register sensors, attach files and simulate telemetry (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 8 L 3 8 L 5 3 L 8 13 L 10 8 L 14 8"
                                  Stroke="{StaticResource AccentBlue}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Sensor Data Ingestion &amp; Telemetry" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CommandStreamTab" Style="{StaticResource NavTab}" GroupName="Pillars"
                                 Checked="OnPillarChecked" Tag="CommandStream"
                                 ToolTip="Live queues, manual overrides with undo, and suggested actions (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="15" Height="13" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border BorderBrush="#F59E0B" BorderThickness="1.4" CornerRadius="2" />
                                <Path Data="M 3.5 4.5 L 6 6.5 L 3.5 8.5 M 7.5 9 L 11 9" Stroke="#F59E0B" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock Text="Real-Time Command Stream &amp; History" FontSize="13.5" VerticalAlignment="Center" />
                            <Ellipse x:Name="CommandStreamBadge" Width="7" Height="7" Margin="8,0,0,0"
                                     Fill="{StaticResource StatusRed}" VerticalAlignment="Center" Visibility="Collapsed"
                                     ToolTip="Critical alerts are active" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Locked until the final PoE: disabled, so it can't be clicked or reached with Ctrl+3 -->
                    <RadioButton x:Name="TopologyTab" Style="{StaticResource NavTab}" GroupName="Pillars"
                                 Checked="OnPillarChecked" Tag="Topology" IsEnabled="False"
                                 ToolTipService.ShowOnDisabled="True"
                                 ToolTip="Locked - network topology and mesh routing arrive in the final PoE">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 7 2 L 2 8 M 7 2 L 12 8 M 7 2 L 7 14"
                                  Stroke="{StaticResource TextOnDarkDim}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  Width="14" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Network Topology &amp; Mesh Routing" FontSize="13.5" VerticalAlignment="Center" />
                            <!-- Padlock -->
                            <Path Data="M 3 6.5 L 3 4.5 A 3 3 0 0 1 9 4.5 L 9 6.5 M 1 6.5 L 11 6.5 L 11 13 L 1 13 Z"
                                  Stroke="{StaticResource TextOnDarkDim}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  Width="12" Height="14" Stretch="None" VerticalAlignment="Center" Margin="9,0,0,0" />
                            <Border Style="{StaticResource PillBadge}">
                                <TextBlock Text="FINAL POE" Style="{StaticResource PillBadgeText}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Connection + identity -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource StatusGreenDot}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnectionText" Text="Connecting..." FontSize="12.5"
                                       Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ThroughputText" Text="--" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextOnDarkMuted}" Margin="15,2,0,0" />
                    </StackPanel>

                    <Border Width="1" Height="34" Background="{StaticResource ShellDarkAlt}" Margin="0,0,18,0" />

                    <TextBlock Text="J. Doe · Operator" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextOnDark}" Margin="0,0,12,0" />
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource ShellDarkAlt}">
                        <TextBlock Text="JD" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDark}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Active pillar ==================== -->
        <ContentControl x:Name="MainContent" Grid.Row="1" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="ContentSlide" />
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>
